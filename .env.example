# ---------------------------------------------------------------------------
# Every setting here is OPTIONAL and every line is commented out on purpose:
# copy this file to .env as-is and Atlas still starts, generating its own
# tokens on first run. Uncomment only what you want to change.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Tokens. One or more "caller:secret:scope" triples, comma-separated. The caller
# name is yours - it shows up in the audit log. The scope decides what the token
# can reach:
#   work     -> sections: work, shared
#   personal -> sections: personal, shared
#   shared   -> section:  shared only
# Enforced server-side on every call; an out-of-scope request gets a 403 and is
# written to audit_log along with every allowed call, never dropped silently.
#
# Leave this unset and Atlas generates one token per scope on first start,
# prints them, and saves them to first-run-tokens.txt beside the database.
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# ATLAS_TOKEN=laptop:replace-with-a-generated-secret:work,phone:replace-with-another:personal

# Timezone for reminders, the time footer, and the nightly groom window.
# Any IANA zone name, e.g. America/Chicago, Europe/Berlin, Asia/Tokyo.
# Defaults to the host timezone, then UTC.
#
# ATLAS_TZ=UTC

# Hour of the local day the nightly groom may start (0-23).
#
# ATLAS_GROOM_HOUR=4

# Listen port inside the container. If you change this, change the published
# port in docker-compose.yml to match.
#
# PORT=7784

# Where the SQLite file lives. The image defaults to /app/data/atlas.db, which
# is the mounted volume - you rarely want to change this.
#
# ATLAS_DB_PATH=/app/data/atlas.db
