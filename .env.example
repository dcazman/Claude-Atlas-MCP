# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With no .env at all, Atlas generates one token
# per scope on first start, prints them, and saves them next to the database.
# Set ATLAS_TOKEN when you want to choose the values yourself.
# ---------------------------------------------------------------------------

# One or more "caller:secret:scope" triples, comma-separated. The caller name is
# yours (it shows up in the audit log); the scope decides what the token reaches:
#   work     -> sections: work, shared
#   personal -> sections: personal, shared
#   shared   -> section:  shared only
# Enforcement is server-side on every call. An out-of-scope request gets a 403
# and is written to audit_log along with every allowed call - never dropped
# silently.
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ATLAS_TOKEN=laptop:changeme-work:work,phone:changeme-personal:personal

# Timezone used for reminders, the time footer, and the groom window (IANA name,
# e.g. America/Chicago, Europe/Berlin). Defaults to the host TZ, then UTC.
ATLAS_TZ=UTC

# Hour of the local day the nightly groom may start (0-23, default 4).
ATLAS_GROOM_HOUR=4

PORT=7784
ATLAS_DB_PATH=/app/data/atlas.db
